# SaúdeLink OTP Microservice Environment Configuration

PORT=3000

# Configurações do servidor SMTP para envio de e-mails de código de 6 dígitos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-ou-smtp
SMTP_FROM="SaúdeLink" <no-reply@saudelink.ao>
